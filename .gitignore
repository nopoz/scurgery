# Local tool and editor state. Generic so new tools are covered
# without this file needing to learn their names.
/.*/
!/.github/

# Secrets and local configuration
.env
*.local

# Build output
/scurgery
/dist/
*.exe

# Go test and coverage artifacts
*.test
*.out

# scurgery writes the full tailnet policy here before every change; never
# commit a live policy into a repo.
policy-backup-*.hujson
